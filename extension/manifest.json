{
  "manifest_version": 3,
  "name": "Claude 额度环 · AI 用量",
  "version": "0.7.0",
  "description": "名字右侧显示 Claude 5 小时额度，以及 Claude / ChatGPT 今日使用时长与 token 估算，悬停看合计。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
