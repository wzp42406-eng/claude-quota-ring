{
  "manifest_version": 3,
  "name": "Claude 额度条",
  "version": "0.2.0",
  "description": "在 claude.ai 左下角名字右侧，用两行细线额度表显示 5 小时 / 7 天额度剩余。",
  "host_permissions": ["https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
