{
  "manifest_version": 3,
  "name": "Claude 额度环 · AI 用量",
  "version": "0.10.1",
  "description": "名字右侧显示 Claude 5 小时额度；名字下方显示 Claude / ChatGPT 使用时长与 token（今日/本周/本月/今年/累计），可同步到本机 API。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
